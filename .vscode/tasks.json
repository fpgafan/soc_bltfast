{
    // Tareas del SoC bltfast (Tang Nano 20K).
    //   Ctrl+Shift+B          -> compila la app del archivo abierto (apps/<app>/...) o el .c
    //                            suelto, la carga por UART y abre el terminal
    //   Ctrl+Shift+P > "Tasks: Run Task" -> el resto
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}/sw"
    },
    "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
    },
    "tasks": [
        {
            "label": "Compilar y ejecutar el archivo abierto",
            "detail": "python build.py --src <archivo> --run  (su app de apps/ o el .c suelto; Ctrl+C para salir)",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "--src", "${file}", "--run"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "autoDetect"
            }
        },
        {
            "label": "Compilar y ejecutar una app",
            "detail": "python build.py <app> --run",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "${input:app}", "--run"],
            "group": "build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "autoDetect"
            }
        },
        {
            "label": "Compilar el archivo abierto",
            "detail": "python build.py --src <archivo>  (sin cargar)",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "--src", "${file}"],
            "group": "build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "autoDetect"
            }
        },
        {
            "label": "Terminal serie",
            "detail": "Ver la salida de la placa sin recargar el programa (Ctrl+C para salir)",
            "type": "shell",
            "command": "python",
            "args": ["../tools/load.py", "--monitor-only"],
            "problemMatcher": []
        },
        {
            "label": "Cargar el .fs actual en la FPGA (sin sintetizar)",
            "detail": "python build.py --prog  (~6 s; tras desconectar la placa, si no has cambiado rtl/)",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "--prog"],
            "problemMatcher": []
        },
        {
            "label": "ROM: compilar, sintetizar y cargar en la FPGA (temporal)",
            "detail": "python build.py boot --bit --prog  (se pierde al desconectar la placa)",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "boot", "--bit", "--prog"],
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "autoDetect"
            }
        },
        {
            "label": "ROM: compilar, sintetizar y grabar en la flash (permanente)",
            "detail": "python build.py boot --bit --flash",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "boot", "--bit", "--flash"],
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "autoDetect"
            }
        }
    ],
    "inputs": [
        {
            "id": "app",
            "type": "pickString",
            "description": "App de sw/apps/",
            "options": ["demo", "hello"],
            "default": "demo"
        }
    ]
}
