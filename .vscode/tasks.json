{
    // Tasks for the bltfast SoC (Tang Nano 20K).
    //   Ctrl+Shift+B          -> builds the app of the open file (apps/<app>/...) or the loose
    //                            .c, loads it over UART and opens the terminal
    //   Ctrl+Shift+P > "Tasks: Run Task" -> the rest
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}/sw"
    },
    "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
    },
    "tasks": [
        {
            "label": "Build and run the open file",
            "detail": "python build.py --src <file> --run  (its app in apps/ or the loose .c; Ctrl+C to quit)",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "--src", "${file}", "--run"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "autoDetect"
            }
        },
        {
            "label": "Build and run an app",
            "detail": "python build.py <app> --run",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "${input:app}", "--run"],
            "group": "build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "autoDetect"
            }
        },
        {
            "label": "Build the open file",
            "detail": "python build.py --src <file>  (without loading)",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "--src", "${file}"],
            "group": "build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "autoDetect"
            }
        },
        {
            "label": "Serial terminal",
            "detail": "Watch the board output without reloading the program (Ctrl+C to quit)",
            "type": "shell",
            "command": "python",
            "args": ["../tools/load.py", "--monitor-only"],
            "problemMatcher": []
        },
        {
            "label": "Load the current .fs into the FPGA (no synthesis)",
            "detail": "python build.py --prog  (~6 s; after unplugging the board, if rtl/ has not changed)",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "--prog"],
            "problemMatcher": []
        },
        {
            "label": "ROM: build, synthesize and load into the FPGA (temporary)",
            "detail": "python build.py boot --bit --prog  (lost when the board is unplugged)",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "boot", "--bit", "--prog"],
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "autoDetect"
            }
        },
        {
            "label": "ROM: build, synthesize and write to flash (permanent)",
            "detail": "python build.py boot --bit --flash",
            "type": "shell",
            "command": "python",
            "args": ["build.py", "boot", "--bit", "--flash"],
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "autoDetect"
            }
        }
    ],
    "inputs": [
        {
            "id": "app",
            "type": "pickString",
            "description": "App from sw/apps/",
            "options": ["demo", "hello"],
            "default": "demo"
        }
    ]
}
